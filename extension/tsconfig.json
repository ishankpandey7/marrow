{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": { "@/*": ["../*"] }
  },
  "include": ["background.ts", "browser.ts", "config.ts", "core.ts", "popup/**/*.ts", "test/**/*.ts", "vitest.config.mts"]
}
