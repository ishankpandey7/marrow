# Marrow — environment variables
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Every variable here is documented in docs/ARCHITECTURE.md section 8, including
# exactly which dashboard page it comes from.
#
# NEXT_PUBLIC_ means the value is compiled into the JavaScript every visitor
# downloads. It is not a namespace. Never put a secret behind it.
#
# Leave a variable empty rather than inventing a value. The app throws on a
# missing required variable and names it; a placeholder just moves the failure
# somewhere harder to find.

# --- Supabase (required from Slice 0) ---------------------------------------
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same page, the `service_role` key. Bypasses Row Level Security completely.
# Server-side only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard > Project Settings > Database > Connection string.
# Used by the Supabase CLI to apply migrations. Not read by the app.
SUPABASE_DB_URL=

# --- App (required from Slice 1) --------------------------------------------
# Your origin, no trailing slash. Magic-link redirects are built from this, so
# a wrong value breaks sign-in in production and nowhere else.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Sentry (optional; absent disables error reporting) ---------------------
# Sentry > Project > Settings > Client Keys (DSN). A DSN is not a secret.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Source-map upload at build time only. Set SENTRY_AUTH_TOKEN in Vercel, not
# here. Sentry > Settings > Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Slice 6: browser extension ---------------------------------------------
# Signs the extension's save token. Generate: openssl rand -hex 32
EXTENSION_TOKEN_SECRET=

# --- Slice 7: cron and email ------------------------------------------------
# Every /api/cron/* route requires this as a bearer token.
# Generate: openssl rand -hex 32
CRON_SECRET=

# Optional. Absent means the digest email is off.
RESEND_API_KEY=
